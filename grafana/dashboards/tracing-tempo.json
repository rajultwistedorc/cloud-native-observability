{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "title": "Trace Ingestion Rate",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(tempo_distributor_spans_received_total[5m]))", "legendFormat": "spans/s" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "Span Metrics — Request Rate",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(traces_spanmetrics_calls_total[5m])) by (service)", "legendFormat": "{{service}}" }
      ]
    },
    {
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 8 },
      "id": 3,
      "title": "Trace Search",
      "type": "traces",
      "targets": [
        {
          "queryType": "traceqlSearch",
          "query": "{ resource.service.name =~ \"$service\" && duration > $min_duration }"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["tempo", "tracing"],
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(traces_spanmetrics_calls_total, service)",
        "includeAll": true,
        "multi": true
      },
      {
        "name": "min_duration",
        "type": "textbox",
        "current": { "text": "100ms", "value": "100ms" }
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Tempo Distributed Tracing",
  "uid": "tempo-tracing",
  "version": 1
}
